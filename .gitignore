__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# Corpora are downloaded, never committed. The manifest IS committed: it is what
# lets someone else check that the bytes they fetched are the bytes these results
# were computed on.
data/*
!data/.gitkeep
!data/MANIFEST.json

# Model checkpoints are large and reproducible from a seed. The JSON measurements
# and the run log are the actual output and stay under version control.
results/*.pt
